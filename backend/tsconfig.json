{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": { "@shared/*": ["../shared/*"] }
  },
  "include": ["src", "prisma", "scripts", "tests", "prisma.config.ts", "../shared"]
}
