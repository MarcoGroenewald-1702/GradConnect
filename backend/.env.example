# Copy this file to .env to change settings. Everything has a sensible default for local development.

# PostgreSQL connection. Default: the embedded PostgreSQL 16 started by `npm run dev`
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/gradconnect"

# Set to false if you use your own PostgreSQL (or Docker: docker compose up -d)
USE_EMBEDDED_DB=true
EMBEDDED_DB_PORT=5433

# API
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Secret for signing access tokens (JWT). MUST be changed in production.
JWT_ACCESS_SECRET="dev-only-secret-change-me-in-production"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
